# Optional build-time override for the embedded encryption key.
# If omitted, the binary uses its built-in default key.
# RFS_ENCRYPTION_KEY=your-base64-key
#
# Used only on the first startup. If omitted, the default password is `password`.
# The password hash is then stored in metadata.redb.
RFS_BOOTSTRAP_PASSWORD='change-this-to-a-long-password'
# Legacy installations may keep RFS_USER_PASSWORD_HASH for one-time migration.
# RFS_USER_PASSWORD_HASH='$2b$12$...'
# The admin account is only a placeholder and has no file access.
# RFS_ADMIN_PASSWORD_HASH='$2b$12$...'
#
# Max upload size
RFS_MAX_PREVIEW_SIZE_MB=300
#
# Server's port
PORT=8080
